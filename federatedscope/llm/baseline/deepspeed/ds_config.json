{
  "train_batch_size": 4,
  "steps_per_print": 2000,
  "fp16": {
    "enabled": false,
    "loss_scale": 0,
    "initial_scale_power": 12, 
    "loss_scale_window": 1000,
    "hysteresis": 2,
    "min_loss_scale": 1
  },
  "bf16" : {"enabled": true},
  "optimizer": {
     "type": "AdamW",
     "params": {
       "lr": 0.001,
       "betas": [
         0.8,
         0.999
       ],
       "eps": 1e-6,
       "weight_decay": 3e-7,
       "torch_adam": true
     }
   },
   "scheduler": {
     "type": "WarmupLR",
     "params": {
       "warmup_min_lr": 0,
       "warmup_max_lr": 0.001,
       "warmup_num_steps": 1000
     }
   },
    "zero_optimization": {
    "stage": 1,
    "overlap_comm": true,
    "contiguous_gradients": true,
    "reduce_bucket_size": "auto"
  },
   "wall_clock_breakdown": false
 }
